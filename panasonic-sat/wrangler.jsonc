{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "panasonic-sat-servicepro",
  "main": "src/main.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "panasonic.desorden.cat",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "JOBS",
        "class_name": "JobsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JobsStore"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
