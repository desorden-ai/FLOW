const CFG={CLIENTS_SHEET:'CLIENTES',SLOTS_SHEET:'FRANJAS',TZ:'Europe/Madrid'};
function doGet(e){try{const action=String(e.parameter.action||'');if(action==='availability')return json_(availability_(e.parameter.token));if(action==='book')return json_(book_(e.parameter.token,e.parameter.slotId));return json_({ok:false,error:'UNKNOWN_ACTION'})}catch(err){console.error(err);return json_({ok:false,error:'SERVER_ERROR'})}}
function availability_(token){const client=getClientByToken_(token);if(!client)return {ok:false,error:'INVALID_TOKEN'};const slots=getSlots_().filter(s=>s.block===client.block&&s.status==='LIBRE').map(s=>({id:s.id,date:s.date,time:s.time}));return {ok:true,client:{name:client.name,address:client.address,city:client.city,whatsapp:client.whatsapp},slots};}
function book_(token,slotId){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const client=getClientByToken_(token);if(!client)return {ok:false,error:'INVALID_TOKEN'};const sh=SpreadsheetApp.getActive().getSheetByName(CFG.SLOTS_SHEET);if(!sh)throw new Error('Missing FRANJAS');const values=sh.getDataRange().getDisplayValues();const h=header_(values[0]);for(let r=1;r<values.length;r++){if(values[r][h.ID]!==slotId)continue;if(values[r][h.BLOQUE]!==client.block)return {ok:false,error:'INVALID_SLOT'};if(values[r][h.ESTADO]!=='LIBRE')return {ok:false,error:'SLOT_TAKEN'};sh.getRange(r+1,h.ESTADO+1).setValue('CONFIRMADO');sh.getRange(r+1,h.CLIENTE_ID+1).setValue(client.id);sh.getRange(r+1,h.CONFIRMADO_EN+1).setValue(new Date()).setNumberFormat('yyyy-mm-dd hh:mm:ss');SpreadsheetApp.flush();return {ok:true,booking:{date:values[r][h.FECHA],time:values[r][h.HORA],status:'CONFIRMADO'}}}return {ok:false,error:'SLOT_NOT_FOUND'};}finally{lock.releaseLock()}}
function getClientByToken_(token){if(!token)return null;const sh=SpreadsheetApp.getActive().getSheetByName(CFG.CLIENTS_SHEET);if(!sh)throw new Error('Missing CLIENTES');const v=sh.getDataRange().getDisplayValues();const h=header_(v[0]);for(let r=1;r<v.length;r++)if(v[r][h.TOKEN]===token)return {id:v[r][h.ID],name:v[r][h.NOMBRE],address:v[r][h.DIRECCION],city:v[r][h.POBLACION],whatsapp:v[r][h.TELEFONO],block:v[r][h.BLOQUE]};return null;}
function getSlots_(){const sh=SpreadsheetApp.getActive().getSheetByName(CFG.SLOTS_SHEET);if(!sh)throw new Error('Missing FRANJAS');const v=sh.getDataRange().getDisplayValues();const h=header_(v[0]);return v.slice(1).map(r=>({id:r[h.ID],block:r[h.BLOQUE],date:r[h.FECHA],time:r[h.HORA],status:r[h.ESTADO]}));}
function header_(row){return row.reduce((o,k,i)=>(o[String(k).trim().toUpperCase()]=i,o),{});}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);}
