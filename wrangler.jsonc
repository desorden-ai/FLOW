{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "flow",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./.vinext/client",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "EDITOR_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
