{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "editable-portfolio-template",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "images": {
    "binding": "IMAGES"
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  }
}
